{
  "name": "hauntology",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.14.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build":    "pnpm -r build",
    "test":     "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api":  "pnpm --filter api dev",
    "dev:web":  "pnpm --filter web dev",
    "check-traceability": "node tools/check-traceability.mjs"
  },
  "workspaces": ["shared", "api", "web"]
}
