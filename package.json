{
  "name": "hauntology",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.14.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build":    "pnpm -r build",
    "test":     "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api":  "pnpm --filter api dev",
    "dev:web":  "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "dev:app":  "pnpm build:web && pnpm dev:api",
    "check-traceability": "node tools/check-traceability.mjs",
    "build-tokens": "node tools/build-tokens.mjs",
    "check-tokens": "node tools/build-tokens.mjs --check",
    "check-voice-library": "node tools/build-banks.mjs --check && node tools/check-voice-library.mjs",
    "test:tools": "node --test tools/test/*.test.mjs",
    "prerender-voice": "node tools/prerender-voice.mjs",
    "voice-demo": "node tools/voice-demo/serve.mjs",
    "ingest-gallery": "node tools/ingest-gallery/ingest.mjs"
  },
  "workspaces": ["shared", "api", "web"]
}
