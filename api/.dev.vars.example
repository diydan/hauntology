# Copy to .dev.vars for `wrangler dev`. Never commit real values.
HMAC_SECRET=replace-with-at-least-16-random-characters
# TURNSTILE_SECRET=
# The public site key the widget needs when TURNSTILE_SECRET is set (not a secret).
# TURNSTILE_SITE_KEY=

# --- Making a world spends real money. Leave these out and no world is made (the Home screen shows worlds closed). ---
# A World API key from platform.worldlabs.ai (not the Atlas key; credits bought in the Marble app do not work). One world on
# the default model (marble-1.1) is about $1.26.
# WLT_API_KEY=
# The draft model is about $0.18 a world: use it for a first try. Anything that is not marble-1.0-draft, marble-1.0, marble-1.1
# or marble-1.1-plus turns world making off.
# WORLD_MODEL=marble-1.0-draft
# Hard limits that SpendGuard enforces whatever else happens (defaults: 2 per visitor, 10 a day, 30 in all). Set the last to what you are willing to spend.
# WORLD_SESSION_CAP=1
# WORLD_DAY_CAP=3
# WORLD_TOTAL_CAP=3
# The model for the Place Brief check (a Workers AI catalog id). Unset is @cf/meta/llama-4-scout-17b-16e-instruct. It also needs the AI
# binding (see wrangler.jsonc): each check is a small paid call, counted against the llm meter (LLM_SESSION_CAP, LLM_DAY_CAP).
# GHOST_MODEL_ID=@cf/meta/llama-4-scout-17b-16e-instruct
# The operator's token for /admin/status and /admin/kill (at least 32 printable characters; without it those routes do not exist).
# Make one in your own shell with `openssl rand -hex 32`. See docs/OPERATIONS.md.
# ADMIN_TOKEN=
# The model that turns a sketch into a photograph (a Workers AI catalog id). Unset is @cf/black-forest-labs/flux-2-klein-9b. It needs the AI
# binding too, and each render is two paid calls against the image meter (IMAGE_SESSION_CAP, IMAGE_DAY_CAP).
# IMAGE_MODEL_ID=@cf/black-forest-labs/flux-2-klein-9b
# The model that checks free text a visitor wrote (a Workers AI catalog id). Unset is @cf/meta/llama-guard-3-8b. It needs the AI binding too,
# and each check is a small paid call against the llm meter. Nothing calls it yet (the ghost and party specs will).
# GUARD_MODEL_ID=@cf/meta/llama-guard-3-8b
