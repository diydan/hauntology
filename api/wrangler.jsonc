// Run locally with `wrangler dev` (4.162.0, local R2 and Durable Object); never deployed. Still to add (world-pipeline task 2):
// the static assets from web/dist (single-page fallback, Worker first), the secrets (HMAC_SECRET, TURNSTILE_SECRET) in
// `.dev.vars` (copy `.dev.vars.example`), the other Durable Objects, and `TURNSTILE_SITE_KEY` when Turnstile is on.
{
  "name": "hauntology",
  "main": "src/worker.ts",
  "compatibility_date": "2025-06-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hauntology-worlds" }],
  "durable_objects": { "bindings": [{ "name": "WORLD_JOB", "class_name": "WorldJob" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldJob"] }],
  // Hourly: delete uploads past 24 hours and user worlds past 7 days.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "WORLD_GEN_ENABLED": "true", "UPLOAD_TTL_HOURS": "24", "WORLD_TTL_DAYS": "7" }
}
