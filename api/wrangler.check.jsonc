// TEST-ONLY config for dev/check-worker.ts (planting routes, an in-memory SpendGuard and a recording job starter). Never deployed:
// `wrangler deploy` reads wrangler.jsonc. Run: `pnpm exec wrangler dev -c wrangler.check.jsonc`, then `LIVE_URL=<its address> pnpm test`.
{
  "name": "hauntology-check",
  "main": "dev/check-worker.ts",
  "compatibility_date": "2025-06-01",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hauntology-worlds" }],
  "durable_objects": { "bindings": [{ "name": "WORLD_JOB", "class_name": "WorldJob" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldJob"] }],
  // Hourly: delete uploads past 24 hours and user worlds past 7 days.
  "triggers": { "crons": ["17 * * * *"] },
  "vars": { "WORLD_GEN_ENABLED": "true", "UPLOAD_TTL_HOURS": "24", "WORLD_TTL_DAYS": "7" }
}
