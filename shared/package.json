{
  "name": "@hauntology/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./app/*": "./src/app/*.ts",
    "./design/*": "./src/design/*.ts",
    "./sketch": "./src/sketch.ts",
    "./log": "./src/log.ts",
    "./session-cookie": "./src/session-cookie.ts",
    "./origin": "./src/origin.ts",
    "./conditions/*": "./src/conditions/*.ts",
    "./ghost/*": "./src/ghost/*.ts",
    "./world/*": "./src/world/*.ts",
    "./puzzles/*": "./src/puzzles/*.ts",
    "./table/*": "./src/table/*.ts",
    "./party/*": "./src/party/*.ts",
    "./print/*": "./src/print/*.ts",
    "./voice/*": "./src/voice/*.ts"
  },
  "scripts": {
    "test":     "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript":    "5.7.2",
    "vitest":        "2.1.8",
    "fast-check":    "3.23.1",
    "@cloudflare/workers-types": "4.20241218.0"
  },
  "dependencies": {
    "zod": "3.24.1"
  }
}
