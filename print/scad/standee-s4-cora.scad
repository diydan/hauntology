module halo_2d(shrink = 0) {
  offset(r = 1.2 - shrink) offset(r = -1.2)
    polygon(points = halo_pts);
}

module ghost_sil_2d(shrink = 0) {
  offset(r = 0.6 - shrink) offset(r = -0.6)
    polygon(points = sil_pts);
}

module standee_s4_cora() {
  difference() {
    union() {
      // 1. Crooked Victorian Graveyard Tombstone Plinth Base (41 x 15 x 9.5 mm)
      burton_standee_plinth_solid(standee_w, standee_d, plinth_h, blade_t, skew = -1.2);

      // 2. Contoured Silhouette Halo Blade with Rounded 45-Deg Bevelled Rim (Y centered at +0.8, 3.4 mm thick)
      translate([0, 0.8, 0])
        rotate([90, 0, 0])
          hull() {
            translate([0, 0, -blade_t / 2 + 0.5])
              linear_extrude(height = blade_t - 1.0)
                halo_2d(0.0);
            translate([0, 0, -blade_t / 2])
              linear_extrude(height = blade_t)
                halo_2d(0.5);
          }

      // 3. Raised Bevelled Frame Rim around Halo Perimeter on Front Face
      translate([0, 0.8 - blade_t / 2, 0])
        rotate([90, 0, 0])
          difference() {
            hull() {
              linear_extrude(height = 0.1) halo_2d(0.4);
              linear_extrude(height = 0.55) halo_2d(0.9);
            }
            translate([0, 0, -0.2])
              linear_extrude(height = 1.2)
                halo_2d(2.0);
          }

      // 4. Sculpted Dual-Layer Ghost Silhouette Cameo Relief on Front Face (45-deg print-safe draft!)
      translate([0, 0.8 - blade_t / 2, 0])
        rotate([90, 0, 0]) {
          // Outer silhouette relief (+0.65 mm)
          hull() {
            linear_extrude(height = 0.05) ghost_sil_2d(0.0);
            linear_extrude(height = 0.65) ghost_sil_2d(0.55);
          }
          // Inner garment/portrait contour relief (+1.05 mm)
          hull() {
            linear_extrude(height = 0.60) ghost_sil_2d(1.4);
            linear_extrude(height = 1.05) ghost_sil_2d(2.0);
          }
        }

    }

    // 5. Recessed 0.4 mm Name Strip Sticker Pocket (34 x 5.6 mm) + Graveyard Stone Cracks
    burton_standee_plinth_cuts(standee_w, standee_d, plinth_h, skew = -1.2);
  }
}

color(col_bone) standee_s4_cora();
