{
  // Static site for https://hauntology.app. No Worker script, only assets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hauntology-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // hauntology.app must be a zone in the Cloudflare account that deploys this.
  // Deploying creates the DNS record and certificate for the apex domain.
  "routes": [{ "pattern": "hauntology.app", "custom_domain": true }],
  // Only the custom domain serves the site. No *.workers.dev URL, no preview URLs.
  "workers_dev": false,
  "preview_urls": false
}
