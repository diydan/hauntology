# NOTE: do NOT ignore /.kiro. Kiroween requires it committed.
# NOTE: do NOT ignore pnpm-lock.yaml. Pinned versions must be committed.

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.vite/
*.tsbuildinfo

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
.worldlabs/
worldlabs-credentials*

# Rendered Voice Library audio (tools/prerender-voice.mjs). Audio lives in R2 only; never commit it.
/.voice-library/

# The narrator spike's replies, ledger and Durable Object state (tools/ghost-spike.mjs, docs/spikes/4.1.md). Local only.
/.ghost-spike/
# The narrator play-through's replies, ledger and Durable Object state (tools/ghost-playthrough.mjs, docs/spikes/4.2.md). Local only.
/.ghost-playthrough/

# Dev MCP ledger and recorded raw responses with keys
tools/worldlabs-mcp/.ledger.json

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Generated 3D print output (rebuilt by tools/build-print.mjs)
print/out/
*.stl.tmp

# Scratch and local outputs
scratch/
tmp/
out/
*.local

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Kiro Crew app plumbing (UI state for specs, not part of the spec)
.kiro/specs/*/.spec-state.json

# Uncut model renders for the web hero media (web/public/media). The cut loops ship; the
# raw renders carry a burned-in vendor watermark and are kept locally as provenance only.
web/public/media/src/
