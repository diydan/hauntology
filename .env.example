# Copy to .env and fill in. .env is ignored by git, and holds real secrets: never put a real value in this file.

# Song Service for the game-songs spike (task 1).
MUREKA_API_KEY=
# A World Labs (Marble) API key. Nothing in this repository reads it yet.
WORLDLABS_API_KEY_MARBLE=

# --- The deployed Worker (first deployed 2026-11-16; docs/VOICE-WINDOW.md) ---
# Where it is, for the curl commands in the guide.
HOST=https://your-worker.workers.dev
# Signs the Session cookie: at least 16 characters, and every /api request needs it (without it the Worker throws). Make one with `openssl rand -hex 32`, keep it here, and
# set the same value on the Worker: `printf %s "$HMAC_SECRET" | pnpm --filter api exec wrangler secret put HMAC_SECRET`.
HMAC_SECRET=
# The operator's token: at least 32 printable characters. It opens /admin, including the voice window (POST /admin/voice), and without it there are no /admin routes. Make one the
# same way and set it with `wrangler secret put ADMIN_TOKEN`.
ADMIN_TOKEN=
# Not set on the Worker, so these stay off. Add them (with `wrangler secret put`) only when you decide to spend; see api/.dev.vars.example for what each one costs.
# WLT_API_KEY=
# TURNSTILE_SECRET=
